    if isinstance(value, (list, tuple)) and len(value) >= 2:
        return float(value[0]), float(value[1])
    if isinstance(value, str):
        nums = re.findall(r"-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?", value)
        if len(nums) >= 2:
            return float(nums[0]), float(nums[1])

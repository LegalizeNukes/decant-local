    "opacity", "blendMode", "blurStrength", "blurEnabled", "isBlurEnabled", "hasBlur",
    "hasLightingEffects", "gathersSpecularByElement", "hasSpecular",
    "translucency", "translucencyEnabled", "isTranslucencyEnabled", "hasTranslucency",
    "shadowStyle", "shadowOpacity", "shadowEnabled", "isShadowEnabled", "hasShadow",
    "hidden", "frame", "position", "fixedFrame", "color", "gradient",
    "colors", "colorStops", "gradientStartPoint", "gradientEndPoint", "gradientType",

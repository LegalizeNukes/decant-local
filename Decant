    return layer.get("savedSVG") or layer.get("savedImage")


def file_digest(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()


def copy_asset(src, dst):
    if src.lower().endswith(".svg"):
        normalize_svg_copy(src, dst)
    else:
        shutil.copy2(src, dst)


def variant_asset_name(base_name, appearance, used_names):
    stem, ext = os.path.splitext(base_name)
    candidate = "%s.%s%s" % (stem, appearance, ext)
    n = 2
    while candidate in used_names:
        candidate = "%s.%s-%d%s" % (stem, appearance, n, ext)
        n += 1
    return candidate


RAW_APPEARANCES = {
    "NSAppearanceNameAqua", "NSAppearanceNameDarkAqua", "ISAppearanceTintable",
    "UIAppearanceAny", "UIAppearanceDark", "Default", "UIAppearanceLight",
}
RAW_SUFFIXES = (
    "__rawData", "__data", "__srcData", "__sourceData", "__svgData", "__vectorData",
)


def normalized_asset_key(name):
    return re.sub(r"[^A-Za-z0-9.]+", "", name)


def parsed_appearance_name(path, raw=False):
    stem = path.stem
    if raw:
        for suffix in RAW_SUFFIXES:
            if stem.endswith(suffix):
                stem = stem[:-len(suffix)]
                break
    for appearance in RAW_APPEARANCES:
        suffix = "__" + appearance
        if stem.endswith(suffix):
            return normalized_asset_key(stem[:-len(suffix)]), appearance
    return None


def overlay_raw_svgs(extract_dir, raw_dir):
    """Replace CoreSVG fallbacks with original rendition bytes when available."""
    if not raw_dir:
        return []
    extract_path = Path(extract_dir)
    raw_path = Path(raw_dir)
    full_map = {}
    for path in extract_path.glob("*.svg"):
        key = parsed_appearance_name(path)
        if key:
            full_map.setdefault(key, path)

    replaced = {}
    results = []
    for source in raw_path.glob("*.svg"):
        key = parsed_appearance_name(source, raw=True)
        target = full_map.get(key)
        if not key or not target:
            continue
        shutil.copy2(source, target)
        size = source.stat().st_size
        replaced[target.name] = size
        results.append((source.name, target.name, size))

    if not replaced:
        return results

    extracted_json = extract_path / "extracted.json"
    document = json.loads(extracted_json.read_text(encoding="utf-8"))

    def update(node):
        if not isinstance(node, dict):
            return
        saved = node.get("savedSVG")
        if saved in replaced:
            node["svgSource"] = "raw-SVG-overlay:_rendition.rawData"
            node["svgBytes"] = replaced[saved]
            node["rawSVGOverlayApplied"] = True
        for child in node.get("layers") or []:
            update(child)

    for appearance in document.values():
        if isinstance(appearance, dict):
            for group in appearance.get("groups") or []:
                update(group)
    extracted_json.write_text(json.dumps(document, indent=2, sort_keys=True) + "\n",
                              encoding="utf-8")
    return results


# --- group property values (computed from a raw extracted group dict) ---

def is_icon_group(g):
    """Accept the original CoreUI class and renamed/private subclasses."""
    return "IconLayerGroup" in str(g.get("class") or "")


def compiled_xcode_major(extract_dir):
    """Read the AssetStorageVersion recorded by assetutil, when available."""
    path = os.path.join(extract_dir, "assetutil.json")
    try:
        info = json.load(open(path))
        header = info[0] if isinstance(info, list) and info else {}
        text = str(header.get("AssetStorageVersion") or "")
        match = re.search(r"\bXcode\s+(\d+)", text)
        return int(match.group(1)) if match else None
    except (OSError, ValueError, TypeError):
        return None


def uses_macos27_schema(d, extract_dir):
    """Detect Icon Composer 2 metadata, with an override for ambiguous icons."""
    if FORMAT_MODE in ("27", "macos27", "v2"):
        return True
    if FORMAT_MODE in ("26", "macos26", "v1"):
        return False
    if FORMAT_MODE != "auto":
        raise ValueError("DECANT_FORMAT must be auto, 26, or 27")
    major = compiled_xcode_major(extract_dir)
    if major is not None:
        return major >= 27
    boolean_keys = {
        "refractionEnabled", "isRefractionEnabled",
        "refractivityEnabled", "isRefractivityEnabled",
        "hasRefraction", "hasRefractivity",
    }
    for appearance in d.values():
        if not isinstance(appearance, dict):
            continue
        pending = list(appearance.get("groups") or [])
        while pending:
            item = pending.pop()
            # icon-extract records the numeric refraction/specular-placement
            # properties even for older icons, where they are all zero.  Their
            # mere presence therefore cannot identify the macOS 27 schema.
            if any(bool(item.get(key)) for key in boolean_keys):
                return True
            if any(float(item.get(key, 0) or 0) != 0 for key in
                   ("refractionStrength", "refractivityStrength",
                    "refractionHeight", "refractionDepth", "refractivityDepth",
                    "specularPlacement", "specularLocation")):
                return True
            pending.extend(item.get("layers") or [])
    return False

def g_blend(g):
    return BLEND.get(g.get("blendMode", 0), "normal")

def g_lighting(g):
    return "individual" if g.get("gathersSpecularByElement") else "combined"

def g_specular(g):
    if not g.get("hasSpecular"):
        return False
    placement = g.get("specularPlacement", g.get("specularLocation", 0))
    if isinstance(placement, str) and placement in ("inside", "outside"):
        return placement
    return SPEC_PLACEMENT.get(placement, True)

def g_translucency(g):
    enabled_keys = ("translucencyEnabled", "isTranslucencyEnabled", "hasTranslucency")
    enabled = next((bool(g[k]) for k in enabled_keys if k in g), None)
    # CoreUI's compiled layer-group object does not expose a separate switch on
    # either the v26 (CoreUI 974) or v27 (CoreUI 1010) catalogs tested. Across
    # Apple's v27 system icons the compiled convention is zero = disabled and
    # any nonzero amount = enabled. One remains a valid enabled amount (Pages'
    # dark pen highlight is an important example).
    if enabled is None:
        enabled = abs(float(g.get("translucency", 0) or 0)) > 1e-7
    return {"enabled": enabled,
            "value": round(g.get("translucency", 1), 4)}

def g_opacity(g):
    return round(g.get("opacity", 1), 4)

def g_blur(g):
    # Zero is meaningful in an appearance specialization: it disables a blur
    # that is enabled in another appearance.  Returning None here caused the
    # dark-mode zero to be discarded and the light blur to apply universally.
    enabled_keys = ("blurEnabled", "isBlurEnabled", "hasBlur")
    enabled = next((bool(g[k]) for k in enabled_keys if k in g), None)
    if enabled is False:
        return 0
    return round(g.get("blurStrength", 0) or 0, 4)

def g_shadow(g):
    enabled_keys = ("shadowEnabled", "isShadowEnabled", "hasShadow")
    enabled = next((bool(g[k]) for k in enabled_keys if k in g), None)
    style = 0 if enabled is False else g.get("shadowStyle", 0)
    kind = SHADOW.get(style, "neutral")
    # CoreUI leaves an undefined/stale opacity in groups whose shadow style is
    # none (Freeform reports 1.44). Icon Composer still validates the opacity
    # field even though it does not render it, so use its neutral default.
    opacity = 0.5 if kind == "none" else round(g.get("shadowOpacity", 0.5), 4)
    return {"kind": kind, "opacity": opacity}

def g_refractivity(g):
    s = round(g.get("refractionStrength", g.get("refractivityStrength", 0)) or 0, 4)
    h = round(g.get("refractionHeight",
                    g.get("refractionDepth", g.get("refractivityDepth", 0))) or 0, 4)
    enabled_keys = ("refractionEnabled", "isRefractionEnabled",
                    "refractivityEnabled", "isRefractivityEnabled",
                    "hasRefraction", "hasRefractivity")
    enabled = next((bool(g[k]) for k in enabled_keys if k in g), None)
    if enabled is None and not (s or h):
        return None
    if enabled is None:
        enabled = True
    return {"enabled": enabled, "strength": s, "depth": h}


def g_refractivity_enabled(g):
    value = g_refractivity(g)
    return bool(value and value["enabled"])


def meaningful_metadata(value):
    """Whether an unknown runtime value could affect rendered output."""
    if value is None or value is False or value == 0 or value == "":
        return False
    if isinstance(value, (list, tuple)):
        return any(meaningful_metadata(v) for v in value)
    if isinstance(value, dict):
        # Runtime object descriptions are provenance, not evidence that an
        # effect is enabled.  Structured numeric/bool values are actionable.
        if set(value) <= {"class", "description", "bytes"}:
            return False
        return any(meaningful_metadata(v) for v in value.values())
    return True


def iter_extracted_nodes(d):
    """Yield (appearance/path, node) for stacks, groups and layers."""
    for appearance, appdata in d.items():
        if not isinstance(appdata, dict) or "groups" not in appdata:
            continue
        yield appearance + "/stack", appdata

        def visit(node, path):
            yield path, node
            for index, child in enumerate(node.get("layers") or []):
                label = basename(str(child.get("name") or child.get("class") or index))
                yield from visit(child, "%s/%s[%d]" % (path, label, index))

        for index, group in enumerate(appdata.get("groups") or []):
            label = basename(str(group.get("name") or group.get("class") or index))
            yield from visit(group, "%s/%s[%d]" % (appearance, label, index))


def reconstruction_report(d, extract_dir, icon, format27):
    """Describe reconstruction coverage and every potentially lossy choice."""
    warnings = []
    notices = []
    unknown = []
    appearances = [k for k, v in d.items()
                   if isinstance(v, dict) and "groups" in v]

    major = compiled_xcode_major(extract_dir)
    if major is None:
        notices.append({
            "code": "compiler-version-unavailable",
            "message": "assetutil.json was unavailable; schema version was inferred from effect metadata."
        })

    for path, node in iter_extracted_nodes(d):
        metadata = node.get("runtimeMetadata") or {}
        values = metadata.get("values") or {}
        types = metadata.get("types") or {}
        for name, value in values.items():
            canonical_name = name.lstrip("_")
            if canonical_name in MAPPED_ACCESSORS or canonical_name in INFORMATIONAL_ACCESSORS:
                continue
            # Only warn for names likely to control icon rendering. Other
            # properties remain inventoried in extracted.json for inspection.
            lname = name.lower()
            shaped = any(token in lname for token in
                         ("blur", "shadow", "specular", "transluc", "refract",
                          "light", "opacity", "blend", "hidden", "frame",
                          "position", "transform", "material", "color", "gradient"))
            item = {"path": path, "accessor": name, "type": types.get(name), "value": value}
            unknown.append(item)
            if shaped and meaningful_metadata(value):
                warnings.append({
                    "code": "unmapped-runtime-metadata", "path": path,
                    "field": name,
                    "message": "CoreUI exposed an active metadata field that is not mapped to icon.json."
                })

        blend = node.get("blendMode")
        if blend is not None and blend not in BLEND:
            warnings.append({"code": "unknown-blend-mode", "path": path, "value": blend})
        shadow = node.get("shadowStyle")
        if shadow is not None and shadow not in SHADOW:
            warnings.append({"code": "unknown-shadow-style", "path": path, "value": shadow})
        placement = node.get("specularPlacement", node.get("specularLocation"))
        if isinstance(placement, (int, float)) and placement and placement not in SPEC_PLACEMENT:
            warnings.append({"code": "unknown-specular-location", "path": path, "value": placement})
        gradient = node.get("gradient")
        if gradient and len(gradient.get("colors") or []) > 2:
            warnings.append({
                "code": "gradient-stop-limit", "path": path,
                "message": "Icon Composer accepts two-stop layer gradients; intermediate CoreUI stops were not representable."
            })
        explicit_translucency = any(k in node for k in
                                    ("translucencyEnabled", "isTranslucencyEnabled", "hasTranslucency"))
        if "translucency" in node and not explicit_translucency:
            amount = float(node.get("translucency", 0) or 0)
            notices.append({
                "code": "compiled-translucency-switch", "path": path,
                "amount": amount,
                "inferred-enabled": abs(amount) > 1e-7,
                "message": "CoreUI stores the rendered translucency switch in the compiled amount: zero is off and nonzero is on."
            })

        colors = []
        if isinstance(node.get("color"), dict):
            colors.append(node["color"])
        if isinstance(gradient, dict):
            colors.extend(c for c in gradient.get("colors") or [] if isinstance(c, dict))
        if path.endswith("/stack"):
            canvas = node.get("canvasFill") or {}
            colors.extend(c for c in canvas.get("colors") or [] if isinstance(c, dict))
            if len(canvas.get("colors") or []) > 2:
                warnings.append({
                    "code": "canvas-gradient-stop-limit", "path": path,
                    "message": "Icon Composer's editable fill cannot represent every CoreUI canvas gradient stop."
                })
        for color in colors:
            space = color.get("colorspace")
            if space not in CS:
                warnings.append({
                    "code": "unknown-color-space", "path": path, "value": space,
                    "message": "Color was serialized as sRGB because its CoreGraphics color space has no known Icon Composer token."
                })
        if node.get("savedSVG") and node.get("svgSource") == "CGSVGDocumentWriteToURL":
            warnings.append({
                "code": "regenerated-svg", "path": path,
                "message": "Original rendition SVG bytes were unavailable; CoreSVG regenerated this asset."
            })
        if (node.get("layers") is None and
                "IconLayerGroup" not in str(node.get("class") or "") and
                not saved_asset(node) and
                any(k in node for k in ("opacity", "blendMode", "hasLightingEffects"))):
            warnings.append({
                "code": "missing-layer-payload", "path": path,
                "message": "A rendered layer had no recoverable SVG or bitmap payload."
            })
        frame = parse_frame(node.get("frame"))
        if frame and abs(frame[2] - frame[3]) > 0.01:
            notices.append({
                "code": "non-square-frame", "path": path, "frame": list(frame),
                "message": "Icon Composer exposes uniform scale only; placement uses the longer frame dimension."
            })

    # Appearance structure differences are supported only when CoreUI returns
    # stable corresponding nodes. Report them so disappearance/addition of a
    # layer is never silently treated as a color/effect specialization.
    structures = {}
    for appearance in appearances:
        groups = group_list(d[appearance])
        structures[appearance] = {
            "groups": len(groups),
            "layers-per-group": [len(g.get("layers") or []) for g in groups],
        }
    if len({json.dumps(v, sort_keys=True) for v in structures.values()}) > 1:
        warnings.append({
            "code": "appearance-structure-differs",
            "message": "Group/layer counts differ between appearances; inspect alignment before relying on the result.",
            "structures": structures,
        })

    # Deduplicate warnings produced by identical default/Aqua lookup objects.
    seen = set()
    unique_warnings = []
    for item in warnings:
        marker = json.dumps(item, sort_keys=True, default=str)
        if marker not in seen:
            seen.add(marker)
            unique_warnings.append(item)

    return {
        "report-version": 2,
        "builder-version": 4,
        "complete": not unique_warnings,
        "target-schema": "macOS 27" if format27 else "macOS 26",
        "asset-compiler-major": major,
        "extractor": d.get("_decant") or {"extractorSchema": 1},
        "appearances": appearances,
        "output": {
            "groups": len(icon.get("groups") or []),
            "layers": sum(len(g.get("layers") or []) for g in icon.get("groups") or []),
            "features": icon.get("features") or [],
        },
        "warnings": unique_warnings,
        "notices": notices,
        "unmapped-runtime-inventory": unknown,
    }


def specialize(grp, key, value_fn, base_g, peers):
    """Emit `key` on grp as a scalar, or as `key-specializations` if the value
    differs across appearances. `peers` is a list of (tag, group_dict). A value
    of None means 'property absent' for that appearance."""
    base_val = value_fn(base_g)
    diffs = []
    for tag, og in peers:
        if og is None:
            continue
        v = value_fn(og)
        if v != base_val:
            diffs.append((tag, v))
    if not diffs:
        if base_val is not None:
            grp[key] = base_val
        return
    # Null is a meaningful specialization value: it clears a setting that is
    # present in another appearance.  Dropping it makes that other value leak
    # into light/dark/tinted rendering.
    grp[key + "-specializations"] = ([{"value": base_val}] +
                                      [{"appearance": tag, "value": v}
                                       for tag, v in diffs])


def group_list(appdata):
    """Ordered list of real icon-layer groups for an appearance."""
    if not isinstance(appdata, dict):
        return []
    return [g for g in appdata["groups"] if is_icon_group(g)]


def main():
    if len(sys.argv) < 3:
        sys.exit(__doc__)
    extract_dir, out = sys.argv[1], sys.argv[2]
    raw_dir = sys.argv[3] if len(sys.argv) > 3 else None
    replaced = overlay_raw_svgs(extract_dir, raw_dir)
    if replaced:
        print("recovered %d original SVG rendition(s)" % len(replaced))
    elif raw_dir:
        print("no original SVG replacements were available; using CoreSVG fallbacks")
    d = json.load(open(os.path.join(extract_dir, "extracted.json")))

    # Pick the default (light) appearance as the structural base.
    base_key = next((k for k in BASE_PREFERENCE if isinstance(d.get(k), dict)), None)
    if base_key is None:
        base_key = next(k for k, v in d.items()
                        if isinstance(v, dict) and "groups" in v)
    base = d[base_key]
    other = []
    seen_specializations = set()
    for k, tag in APPEARANCE_TAGS:
        if k == base_key or not isinstance(d.get(k), dict):
            continue
        if tag is not None:
            if tag in seen_specializations:
                continue
            seen_specializations.add(tag)
        other.append((k, tag))
    idx = {k: index_appearance(d[k]) for k, _ in other}
    # Per-appearance group lists, aligned by real-group ordinal, for group-level
    # specializations (blend-mode, specular, translucency, etc. that vary by mode).
    other_groups = [(tag, group_list(d[k])) for k, tag in other if tag is not None]
    base_rgi = -1  # ordinal among real (non-placeholder) base groups

    assets_dir = os.path.join(out, "Assets")
    os.makedirs(assets_dir, exist_ok=True)
    used_asset_names = set()
    asset_name_by_digest = {}

    def install_asset(saved, preferred, appearance="variant"):
        """Copy one unique payload and reuse it when appearances share bytes."""
        src = os.path.join(extract_dir, saved)
        digest = file_digest(src)
        if digest in asset_name_by_digest:
            return asset_name_by_digest[digest]
        name = preferred
        if name in used_asset_names:
            name = variant_asset_name(preferred, appearance, used_asset_names)
        copy_asset(src, os.path.join(assets_dir, name))
        used_asset_names.add(name)
        asset_name_by_digest[digest] = name
        return name
    groups_out = []
    bottom_fill = None
    uses_refraction = False
    uses_specular_location = False

    for gi, g in enumerate(base["groups"]):
        if not is_icon_group(g):
            continue  # skip top-level gradient/color placeholder entries
        base_rgi += 1
        # aligned peer groups in other appearances (by real-group ordinal)
        peers = [(tag, (glist[base_rgi] if base_rgi < len(glist) else None))
                 for tag, glist in other_groups]
        group_pos = position_for(g.get("frame"))
        layers_out = []
        for li, l in enumerate(g.get("layers", [])):
            saved = saved_asset(l)
            if not saved:
                continue
            ext = os.path.splitext(saved)[1]
            preferred = basename(l["name"]) + ext
            clean = install_asset(saved, preferred, "base")

            # Preserve distinct dark/tinted artwork rather than always pointing
            # every appearance at the light payload.
            image_overrides = []
            for k, tag in other:
                if tag is None:
                    continue
                la = idx[k].get((base_rgi, li))
                if la is None or not saved_asset(la):
                    continue
                variant_saved = saved_asset(la)
                variant_ext = os.path.splitext(variant_saved)[1] or ext
                variant_preferred = basename(la.get("name") or l["name"]) + variant_ext
                variant_name = install_asset(variant_saved, variant_preferred, tag)
                if variant_name != clean:
                    image_overrides.append({"appearance": tag, "value": variant_name})

            f0 = fill(l)
            if f0 and bottom_fill is None:
                bottom_fill = f0  # first fill in stack order = bottom-most (backmost) layer
            # appearance-specific fill overrides (vs the base/light fill)
            overrides = []
            for k, tag in other:
                la = idx[k].get((base_rgi, li))
                if la is None:
                    continue
                fa = fill(la)
                if fa != f0 and tag is not None:
                    # A missing CoreUI fill means use the artwork's own colors.
                    overrides.append({"appearance": tag,
                                      "value": fa if fa is not None else "none"})
            layer = {"image-name": clean, "name": basename(l["name"])}
            if image_overrides:
                layer["image-name-specializations"] = [{"value": clean}] + image_overrides
            # Fill emission. A base fill of None means "no override — use the
            # artwork's own colors" (e.g. an SVG with its own gradient). In that
            # case only the appearance overrides go into fill-specializations,
            # WITHOUT a base value entry — otherwise an appearance-only override
            # (like tinted's gray) would wrongly recolor light/dark too.
            if f0 is None:
                if overrides:
                    layer["fill-specializations"] = overrides
            elif overrides:
                layer["fill-specializations"] = [{"value": f0}] + overrides
            else:
                layer["fill"] = f0

            # Layer properties that can vary per appearance. Emitting these as
            # `<key>-specializations` is essential: e.g. App Store's "1.light"
            # layer has opacity 0 in light but 0.89 in dark — without the dark
            # specialization actool drops the (base-0-opacity) layer entirely.
            def peer(tag_key):
                return idx[tag_key].get((base_rgi, li))

            no_default = object()

            def lspecialize(key, value_fn, *, omit_if_default=no_default):
                base_v = value_fn(l)
                diffs = []
                for k, tag in other:
                    if tag is None:
                        continue
                    la = peer(k)
                    if la is None:
                        continue
                    v = value_fn(la)
                    if v != base_v:
                        diffs.append((tag, v))
                if diffs:
                    arr = [{"value": base_v}] + [{"appearance": t, "value": v} for t, v in diffs]
                    layer[key + "-specializations"] = arr
                elif omit_if_default is no_default or base_v != omit_if_default:
                    layer[key] = base_v

            lspecialize("blend-mode", lambda x: BLEND.get(x.get("blendMode", 0), "normal"),
                        omit_if_default="normal")
            lspecialize("opacity", lambda x: round(x.get("opacity", 1), 4),
                        omit_if_default=1)
            lspecialize("hidden", lambda x: bool(x.get("hidden", False)),
                        omit_if_default=False)
            lspecialize("position", lambda x: position_for(x.get("frame")),
                        omit_if_default=None)
            # glass (== hasLightingEffects): refraction/specular only render on
            # glass layers, so this is always emitted.
            lspecialize("glass", lambda x: bool(x.get("hasLightingEffects")))
            layers_out.append(layer)

        # CoreUI stores layers back-to-front; .icon lists them front-to-back.
        layers_out.reverse()

        grp = {"layers": layers_out}
        if g.get("name"):
            grp["name"] = basename(g["name"])
        # Group properties that can vary per appearance -> emit a scalar, or a
        # `<key>-specializations` array when light/dark/tinted differ.
        specialize(grp, "hidden", lambda x: bool(x.get("hidden", False)), g, peers)
        specialize(grp, "position", lambda x: position_for(x.get("frame")), g, peers)
        specialize(grp, "blend-mode", g_blend, g, peers)
        specialize(grp, "lighting", g_lighting, g, peers)
        specialize(grp, "specular", g_specular, g, peers)
        specialize(grp, "translucency", g_translucency, g, peers)
        specialize(grp, "refractivity", g_refractivity, g, peers)
        specialize(grp, "shadow", g_shadow, g, peers)
        # opacity / blur only when non-default (still appearance-aware)
        if g_opacity(g) != 1 or any(og and g_opacity(og) != 1 for _, og in peers):
            specialize(grp, "opacity", g_opacity, g, peers)
        if g_blur(g) != 0 or any(og and g_blur(og) != 0 for _, og in peers):
            specialize(grp, "blur-material", g_blur, g, peers)

        # feature flags (consider all appearances)
        if g_refractivity_enabled(g) or any(og and g_refractivity_enabled(og) for _, og in peers):
            uses_refraction = True
        if g_specular(g) in ("inside", "outside") or \
           any(og and g_specular(og) in ("inside", "outside") for _, og in peers):
            uses_specular_location = True
        groups_out.append(grp)

    # CoreUI stores groups back-to-front; .icon lists them front-to-back.
    groups_out.reverse()

    # Top-level canvas fill. Prefer the icon's authored background gradient
    # ("system-light"/"system-dark" named gradients) when present; otherwise
    # fall back to deriving from the bottom-most layer's fill.
    top_fill, top_fill_specs = canvas_fill(d, base_key, other)
    if top_fill is None:
        if bottom_fill and "solid" in bottom_fill:
            top_fill = {"automatic-gradient": bottom_fill["solid"]}
        elif bottom_fill and "linear-gradient" in bottom_fill:
            top_fill = {"automatic-gradient": bottom_fill["linear-gradient"][-1]}
        else:
            top_fill = {"automatic-gradient": "srgb:0.50000,0.50000,0.50000,1.00000"}

    features = []
    if uses_refraction:
        features.append("refractivity")
    if uses_specular_location:
        features.append("specular-location")

    icon = {}
    if features:
        icon["features"] = features
    if top_fill_specs:
        icon["fill-specializations"] = top_fill_specs
    else:
        icon["fill"] = top_fill
    icon["groups"] = groups_out
    format27 = uses_macos27_schema(d, extract_dir)
    if format27:
        icon["supported-platforms"] = {"squares": "shared"}
    else:
        icon["supported-platforms"] = {"squares": ["macOS"]}

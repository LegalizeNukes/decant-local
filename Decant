    g = layer.get("gradient")
    if g and g.get("colors"):
        return gradient_fill(g)
    c = layer.get("color")
    if c:
        return {"solid": colstr(c)}
    return None


def basename(layer_name):
    # "AppIcon_Assets/1.light" -> "1.light"
    return layer_name.split("/")[-1]


def normalize_svg_copy(src, dst):
    """Copy an SVG while making its root viewport predictable for Icon Composer.
    CoreSVG sometimes writes Liquid Glass layer SVGs with unusual width/height
    values.  Icon Composer appears to use those root dimensions when placing
    artwork, which can make layers come out too large/small even when the
    layer frame is correct.  Keep the original viewBox/artwork, but force the
    file viewport to the 1024x1024 icon authoring canvas.
    """
    try:
        ET.register_namespace('', 'http://www.w3.org/2000/svg')
        tree = ET.parse(src)
        root = tree.getroot()
        # Raw rendition SVGs that already have a viewBox are the original
        # artwork and must remain byte-for-byte intact.  Only repair SVGs whose
        # root has no usable coordinate system.
        if 'viewBox' in root.attrib:
            shutil.copy2(src, dst)
            return
        else:
            def num(v):
                if v is None: return None
                m = re.search(r'-?\d+(?:\.\d+)?', str(v))
                return m.group(0) if m else None
            w = num(root.attrib.get('width')) or '1024'
            h = num(root.attrib.get('height')) or '1024'
            root.set('viewBox', f'0 0 {w} {h}')
        root.set('width', '1024')
        root.set('height', '1024')
        tree.write(dst, encoding='utf-8', xml_declaration=True)
    except Exception:
        shutil.copy(src, dst)


CANVAS = 1024.0  # icon authoring canvas is 1024x1024 points


def parse_frame(s):
    """'{{x, y}, {w, h}}' -> (x, y, w, h) floats, or None."""
    if not s:
        return None
    nums = re.findall(r"-?\d+(?:\.\d+)?", s)
    if len(nums) < 4:
        return None
    return tuple(float(n) for n in nums[:4])


def position_for(frame_str):
    """Convert a captured layer frame to a .icon position {scale, translation-in-points}.
    Default frame {{0,0},{1024,1024}} -> identity (returns None).
    scale = longest frame dimension / canvas; translation = layer-center offset from canvas center,
    with y measured downward (icon canvas origin is top-left)."""
    f = parse_frame(frame_str)
    if not f:
        return None
    x, y, w, h = f
    # .icon exposes one uniform scale value.  For non-square layers, SVG
    # preserveAspectRatio behavior fits the artwork by its longest dimension,
    # so averaging width and height under-scales rectangular assets.
    scale = round(max(w, h) / CANVAS, 5)
    cx = (x + w / 2.0) - CANVAS / 2.0
    cy = (y + h / 2.0) - CANVAS / 2.0
    # near-identity -> omit
    if abs(scale - 1.0) < 1e-3 and abs(cx) < 1.0 and abs(cy) < 1.0:
        return None
    return {"scale": scale,
            "translation-in-points": [round(cx, 3), round(cy, 3)]}


def _orientation(entry):
    s = parse_point(entry.get("start")); e = parse_point(entry.get("end"))
    if not (s and e):
        return None
    return {"start": {"x": round(s[0], 4), "y": round(s[1], 4)},
            "stop": {"x": round(e[0], 4), "y": round(e[1], 4)}}


def is_system_dark_gradient(cf):
    """Recognize Apple's compiled macOS 26 System Dark background.

    Assets.car resolves semantic system fills to concrete colors, so the
    original `system-dark` label is no longer present.  Re-semanticizing this
    exact, public-system signature lets a v26 icon adopt the v27 System Dark
    appearance and lighting model when opened by the newer Icon Composer.
    """
    if not cf:
        return False
    name = str(cf.get("name") or "").split("/")[-1]
    if name == "system-dark":
        return True
    colors = cf.get("colors") or []
    if len(colors) != 2:
        return False
    values = []
    for color in colors:
        components = color.get("components") or []
        if len(components) < 1 or color.get("colorspace") not in {
                "kCGColorSpaceGenericGrayGamma2_2", "kCGColorSpaceLinearGray",
                "kCGColorSpaceGenericGray", "kCGColorSpaceExtendedGray"}:
            return False
        values.append(float(components[0]))
        if len(components) >= 2 and abs(float(components[-1]) - 1.0) > 0.0005:
            return False
    start = parse_point(cf.get("start"))
    end = parse_point(cf.get("end"))
    vertical = (start is not None and end is not None and
                abs(start[0] - 0.5) < 0.001 and abs(start[1]) < 0.001 and
                abs(end[0] - 0.5) < 0.001 and abs(end[1] - 1.0) < 0.001)
    return vertical and abs(values[0] - 0.192) < 0.0005 and abs(values[1] - 0.078) < 0.0005



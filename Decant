def colstr(c):
    if not c:
        return None
    space = CS.get(c["colorspace"], "srgb")
    comp = c["components"]
    # 1-2 component colors are grayscale (value [,alpha]) regardless of space name.
    if space in ("gray", "extended-gray") or len(comp) < 3:
        v = comp[0]
        a = comp[-1] if len(comp) >= 2 else 1.0
        # Untagged two-component colors arrive without a reliable CoreGraphics
        # space name.  Icon Composer's current schema spelling is
        # `extended-gray`, so do not silently fall back to the legacy token.
        prefix = space if space in ("gray", "extended-gray") else "extended-gray"
        return "%s:%.5f,%.5f" % (prefix, v, a)
    if len(comp) >= 4:
        return "%s:%.5f,%.5f,%.5f,%.5f" % (space, comp[0], comp[1], comp[2], comp[3])

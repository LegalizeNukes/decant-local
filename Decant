    >2 colors -> approximate with first+last (actool rejects other counts)."""
    cols = entry.get("colors") or []
    cs = [colstr(c) for c in cols]
    if not cs:
        return None
    if len(cs) == 1:
        return {"solid": cs[0]}
    if len(cs) == 2:
        result = {"linear-gradient": cs}
    else:
        result = {"linear-gradient": [cs[0], cs[-1]]}
    orientation = _orientation(entry)
    if orientation:
        result["orientation"] = orientation
    return result



    # Use the ordinal among actual layer groups.  A stack may contain a
    # different number of leading gradient/color lookups per appearance, so
    # indexing by the raw stack position can associate the wrong layers.
    for gi, g in enumerate(group_list(appdata)):
        for li, l in enumerate(g.get("layers", [])):
